# Environments and caches
.venv/
**/.venv*/
.uv-cache/
.uv-python/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
**/.cache/

# Local secrets
.env
.env.*
**/.env
**/.env.*
!.env.example
*.pem
*.key
credentials*.json
*service-account*.json

# Local, rebuildable or large outputs
index/
results/
/archive/
/tmp/
**/.ollama/
**/models/
*.gguf
*.safetensors
*.bin
*.pt
*.sqlite3
*.sqlite3-*
*.db
*.log
*.zip
~$*

# Fine-tuning: checkpoints, merged weights and exports stay local
finetune/outputs/
finetune/unsloth_compiled_cache/
wandb/

# Only the registered BLS corpus PDFs and experiment reflections are published
*.pdf
!corpus/pdfs/*_bls_*.pdf
!experiments/*/artifacts/reflection.pdf
