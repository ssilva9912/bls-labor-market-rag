# Ollama-only prototype. Existing private configuration is never overwritten.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=1024
OLLAMA_TEMPERATURE=0
OLLAMA_SEED=42
OLLAMA_KEEP_ALIVE=10m
OLLAMA_REQUEST_TIMEOUT_SECONDS=180
OLLAMA_DEADLINE_SECONDS=240

# Must match the existing persisted index. No embedding model switch is needed.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=180
TOP_K=4
CANDIDATE_K=16
RETRIEVAL_MODE=hybrid
